@page "/libros"
@inject ServicioLibros Servicio

<header class="encabezado">
    <div>
        <div class="migas">Catálogos / Libros</div>
        <h1>Libros</h1>
        <p class="subtitulo">Libros que se usan en los cursos y sus existencias en el inventario.</p>
    </div>
    <button type="button" class="btn btn-primario" @onclick="AbrirNuevo">
        <span class="ico" aria-hidden="true">&#xE710;</span> Nuevo libro
    </button>
</header>

<section class="tarjeta filtros" aria-label="Buscar y filtrar">
    <div class="campo" style="flex: 1">
        <label for="buscar">Buscar libro</label>
        <input id="buscar" type="search" class="control"
               placeholder="Nombre, código o nivel"
               @bind="busqueda" @bind:event="oninput" @bind:after="Actualizar" />
    </div>

    <div class="campo" style="width: 200px">
        <label for="estado">Estado</label>
        <select id="estado" class="control" @bind="estado" @bind:after="Actualizar">
            <option value="">Todos</option>
            @foreach (var e in Servicio.Estados)
            {
                <option value="@e">@e</option>
            }
        </select>
    </div>

    <button type="button" class="btn btn-secundario" @onclick="Limpiar">Limpiar filtros</button>
    <button type="button" class="btn btn-secundario" @onclick="Recargar"
            title="Volver a leer las existencias del inventario">
        <span class="ico" aria-hidden="true">&#xE72C;</span> Actualizar
    </button>
</section>

<section class="tarjeta tabla-contenedor" aria-label="Lista de libros">
    @if (errorCarga is not null)
    {
        <div class="vacio" role="alert">No se pudieron cargar los libros. @errorCarga</div>
    }
    else if (filtrados.Count == 0)
    {
        <div class="vacio">No se encontraron libros con esos filtros.</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th scope="col">Libro</th>
                    <th scope="col">Niveles</th>
                    <th scope="col">Existencias</th>
                    <th scope="col">Estado</th>
                    <th scope="col" style="text-align: right">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in PaginaActual)
                {
                    <tr>
                        <td>
                            <div class="alumno">
                                <Portada />
                                <div>
                                    <div class="alumno-nombre">@l.Descripcion</div>
                                    <div class="alumno-email">@(l.Codigo ?? "Sin código")</div>
                                </div>
                            </div>
                        </td>
                        <td class="texto-sec">@(l.Niveles.Length == 0 ? "—" : l.Niveles)</td>
                        <td>@l.Existencias</td>
                        <td><span class="insignia @(l.Activo ? "activo" : "inactivo")">@(l.Activo ? "Activo" : "Inactivo")</span></td>
                        <td>
                            <div class="acciones">
                                <button type="button" class="btn btn-icono" title="Ver"
                                        aria-label="@($"Ver {l.Descripcion}")" @onclick="() => AbrirVer(l)">
                                    <span class="ico" aria-hidden="true">&#xE890;</span>
                                </button>
                                <button type="button" class="btn btn-icono" title="Editar"
                                        aria-label="@($"Editar {l.Descripcion}")" @onclick="() => AbrirEditar(l)">
                                    <span class="ico" aria-hidden="true">&#xE70F;</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="pie-tabla">
        <span>@Resumen</span>
        <nav class="paginacion" aria-label="Paginación">
            <button type="button" class="btn btn-icono" aria-label="Página anterior"
                    disabled="@(pagina <= 1)" @onclick="() => pagina--">
                <span class="ico" aria-hidden="true">&#xE76B;</span>
            </button>
            <span>Página @pagina de @TotalPaginas</span>
            <button type="button" class="btn btn-icono" aria-label="Página siguiente"
                    disabled="@(pagina >= TotalPaginas)" @onclick="() => pagina++">
                <span class="ico" aria-hidden="true">&#xE76C;</span>
            </button>
        </nav>
    </div>
</section>

@* ============ Ventana modal: ver / nuevo / editar ============ *@
@if (modo != Modo.Cerrado)
{
    <div class="modal-fondo" @onclick="Cerrar">
        <div class="tarjeta modal" role="dialog" aria-modal="true" aria-labelledby="modal-titulo"
             @onclick:stopPropagation @onkeydown="TeclaEnModal">

            <h2 id="modal-titulo">@TituloModal</h2>

            @if (modo == Modo.Ver)
            {
                <dl class="detalle">
                    <dt>Código</dt>
                    <dd>@(libro.Codigo ?? "—")</dd>
                    <dt>Niveles</dt>
                    <dd>@(libro.Niveles.Length == 0 ? "—" : libro.Niveles)</dd>
                    <dt>Existencias</dt>
                    <dd>@libro.Existencias <span class="texto-sec">(inventario de SOCOADA)</span></dd>
                    <dt>Estado</dt>
                    <dd><span class="insignia @(libro.Activo ? "activo" : "inactivo")">@(libro.Activo ? "Activo" : "Inactivo")</span></dd>
                </dl>

                <div class="modal-pie">
                    <button type="button" class="btn btn-secundario" @ref="botonCerrar" @onclick="Cerrar">Cerrar</button>
                    <button type="button" class="btn btn-primario" @onclick="() => { modo = Modo.Editar; enfocar = true; }">
                        <span class="ico" aria-hidden="true">&#xE70F;</span> Editar
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="libro" OnValidSubmit="Guardar" class="pila">
                    <DataAnnotationsValidator />

                    <div class="rejilla rejilla-2">
                        <div class="campo">
                            <label for="codigo">Código <span class="req">*</span></label>
                            <InputText id="codigo" class="control" placeholder="Ej. FC1" style="text-transform: uppercase"
                                       readonly="@(modo == Modo.Editar)"
                                       @ref="campoCodigo" @bind-Value="libro.Codigo" />
                            <span class="ayuda">
                                @(modo == Modo.Editar
                                    ? "El código no se puede cambiar"
                                    : "Igual al del inventario. Ya no se puede cambiar después")
                            </span>
                            <ValidationMessage For="() => libro.Codigo" />
                        </div>

                        <div class="campo">
                            <label for="descripcion">Nombre <span class="req">*</span></label>
                            <InputText id="descripcion" class="control" placeholder="Ej. Four Corners 1"
                                       @ref="campoDescripcion" @bind-Value="libro.Descripcion" />
                            <ValidationMessage For="() => libro.Descripcion" />
                        </div>

                        <fieldset class="campo span-2">
                            <legend>Estado</legend>
                            <InputRadioGroup @bind-Value="libro.Activo">
                                <div class="segmentado" style="max-width: 320px">
                                    <label><InputRadio TValue="bool" Value="true" /><span>Activo</span></label>
                                    <label><InputRadio TValue="bool" Value="false" /><span>Inactivo</span></label>
                                </div>
                            </InputRadioGroup>
                            <span class="ayuda">Inactivo = el libro ya no se usa en los cursos</span>
                        </fieldset>
                    </div>

                    <p class="ayuda" style="margin: 0">
                        Las existencias se toman del inventario de SOCOADA; aquí no se capturan.
                        El libro de cada nivel se asigna en el catálogo de niveles.
                    </p>

                    @if (errorGuardar is not null)
                    {
                        <div class="validation-message" role="alert">@errorGuardar</div>
                    }

                    <div class="modal-pie">
                        <button type="button" class="btn btn-secundario" @onclick="Cerrar">Cancelar</button>
                        <button type="submit" class="btn btn-primario">
                            <span class="ico" aria-hidden="true">&#xE74E;</span> Guardar
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@code {
    private const int TamanoPagina = 7;

    private enum Modo { Cerrado, Ver, Nuevo, Editar }

    private string busqueda = "";
    private string estado = "";
    private int pagina = 1;
    private List<Libro> filtrados = new();
    private string? errorCarga;

    // Ventana modal. Se trabaja sobre una copia para que "Cancelar" no deje cambios a medias.
    private Modo modo = Modo.Cerrado;
    private Libro libro = new();
    private string? errorGuardar;
    private bool enfocar;
    private InputText? campoCodigo;
    private InputText? campoDescripcion;
    private ElementReference botonCerrar;

    protected override void OnInitialized()
    {
        // Existencias frescas cada vez que se abre la pantalla
        Servicio.Recargar();
        Actualizar();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Al abrir la ventana: Ver -> botón Cerrar, Nuevo -> código, Editar -> nombre
        if (!enfocar) return;
        enfocar = false;

        if (modo == Modo.Ver)
            await botonCerrar.FocusAsync();
        else if (modo == Modo.Nuevo && campoCodigo?.Element is ElementReference codigo)
            await codigo.FocusAsync();
        else if (campoDescripcion?.Element is ElementReference descripcion)
            await descripcion.FocusAsync();
    }

    private void Actualizar()
    {
        try
        {
            filtrados = Servicio.Buscar(busqueda, estado);
            errorCarga = null;
        }
        catch (Exception ex)
        {
            // Por ejemplo, si el servidor del inventario (10.10.15.3) no responde
            filtrados = new();
            errorCarga = ex.Message;
        }

        pagina = 1;
    }

    private void Recargar()
    {
        Servicio.Recargar();
        Actualizar();
    }

    private void Limpiar()
    {
        busqueda = estado = "";
        Actualizar();
    }

    private void AbrirNuevo() => Abrir(Modo.Nuevo, new Libro());

    private void AbrirEditar(Libro l) => Abrir(Modo.Editar, l.Clonar());

    private void AbrirVer(Libro l) => Abrir(Modo.Ver, l.Clonar());

    private void Abrir(Modo nuevoModo, Libro l)
    {
        libro = l;
        modo = nuevoModo;
        errorGuardar = null;
        enfocar = true;
    }

    private void Cerrar() => modo = Modo.Cerrado;

    private void TeclaEnModal(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Cerrar();
    }

    private void Guardar()
    {
        errorGuardar = Servicio.Guardar(libro);
        if (errorGuardar is not null) return;   // la ventana se queda abierta con lo capturado

        Cerrar();
        Actualizar();
    }

    private string TituloModal => modo switch
    {
        Modo.Nuevo => "Nuevo libro",
        Modo.Editar => "Editar libro",
        _ => libro.Descripcion ?? ""
    };

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(filtrados.Count / (double)TamanoPagina));

    private IEnumerable<Libro> PaginaActual =>
        filtrados.Skip((pagina - 1) * TamanoPagina).Take(TamanoPagina);

    private string Resumen => filtrados.Count == 0
        ? "Sin resultados"
        : $"Mostrando {(pagina - 1) * TamanoPagina + 1}–{Math.Min(pagina * TamanoPagina, filtrados.Count)} de {filtrados.Count} libros";
}